{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "name": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && newData.val().length >= 3 && newData.val().length <= 24",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 24"
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 3 && newData.child('name').val().length <= 24"
      }
    },
    "messages": {
      "$messageId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('banned').val() !== true && (!root.child('users').child(auth.uid).child('blockedUntil').exists() || root.child('users').child(auth.uid).child('blockedUntil').val() <= now)",
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid && root.child('users').child(auth.uid).child('banned').val() !== true && root.child('users').child(auth.uid).child('muted').val() !== true && (!root.child('users').child(auth.uid).child('blockedUntil').exists() || root.child('users').child(auth.uid).child('blockedUntil').val() <= now)",
        ".validate": "newData.hasChildren(['userId','text','time']) && newData.child('userId').isString() && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('time').isNumber() && newData.child('name').val() === root.child('users').child(auth.uid).child('name').val()"
      }
    },
    "site": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "moderationLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
